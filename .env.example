ENVIRONMENT=production
# HOST/PORT/RELOAD configure the launcher in Docker and locally. Keep reload off in production.
# If changing the container port, update health checks and port mappings too.
HOST=0.0.0.0
PORT=8000
RELOAD=false

# An executable name or path, never a shell command. Restart after changing it.
# One renderer per service instance; its runtime must be installed in the image.
# Qt users provide their own installed runtime or compatible executable wrapper.
GLABELS_EXECUTABLE=glabels-3-batch
GLABELS_TIMEOUT=600
MERGE_TIMEOUT=120
PROCESS_REAP_TIMEOUT=5

# Calculated at startup: floor(detected CPU capacity) minus reserve, minimum 1.
# WORK_TOKENS=0 uses that budget, including under fractional CPU quotas.
# A positive WORK_TOKENS further caps that budget; it cannot raise the CPU cap.
WORK_TOKENS=0
API_CPU_RESERVE=1
MERGE_COST=2
MAX_PENDING_JOBS=32
MAX_INFLIGHT_JOBS=4

# Batch limit counts expanded labels; whole-page batches round down within it.
# Requests that split must declare labels_per_page. 0 disables splitting.
MAX_LABELS_PER_BATCH=300
# Input records before copies; MAX_EFFECTIVE_LABELS limits records * copies.
MAX_LABELS_PER_JOB=2000
MAX_COPIES=100
MAX_EFFECTIVE_LABELS=20000
MAX_BATCHES_PER_JOB=100
MAX_REQUEST_BYTES=5000000
# Unique CSV columns across the job; string value length is in characters.
MAX_FIELDS_PER_LABEL=50
MAX_FIELD_LENGTH=2048
MAX_PDF_BYTES=256000000
MAX_PDF_PAGES=10000
MAX_WORKSPACE_BYTES=512000000
MIN_FREE_DISK_BYTES=128000000

# Persist STATE_DIR AND OUTPUT_DIR across container recreation.
STATE_DIR=state
OUTPUT_DIR=output
TEMP_DIR=temp
TEMPLATES_DIR=templates
RETENTION_HOURS=24
CLEANUP_INTERVAL=60
CLEANUP_BATCH_SIZE=100
SHUTDOWN_TIMEOUT=30

# Application log sinks honor LOG_LEVEL; system/error also have INFO/ERROR floors.
# Uvicorn server logs use its own logging configuration.
LOG_LEVEL=INFO
LOG_FORMAT=text
LOG_DIR=logs
REQUEST_ID_HEADER=X-Request-ID
RATE_LIMIT=60/minute
ENABLE_METRICS=true
CORS_ALLOW_ORIGINS=
